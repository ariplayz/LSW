{
  "openrpc": "1.2.6",
  "info": {
    "title": "LSW Agent JSON-RPC API",
    "description": "JSON-RPC 2.0 API exposed by the LSW Windows guest agent over virtio-serial (org.lsw.agent). See docs/windows-agent-protocol.md for framing details.",
    "version": "0.1.0",
    "contact": { "name": "LSW project" },
    "license": { "name": "GPL-3.0-or-later" }
  },
  "servers": [
    {
      "name": "virtio-serial",
      "summary": "QEMU virtio-serial named pipe / COM port",
      "description": "Length-prefix framed (4-byte LE uint32 + UTF-8 JSON). Windows device: \\\\.\\Global\\org.lsw.agent or configurable COM port."
    }
  ],
  "methods": [
    {
      "name": "handshake",
      "summary": "Authenticate with the agent and advertise capabilities.",
      "params": [
        {
          "name": "token",
          "required": true,
          "description": "Per-VM token generated by lswd, never logged.",
          "schema": { "type": "string", "minLength": 1 }
        },
        {
          "name": "new_token",
          "required": false,
          "description": "If provided and current session is authenticated, rotates the token.",
          "schema": { "type": "string" }
        }
      ],
      "result": {
        "name": "HandshakeResult",
        "schema": {
          "type": "object",
          "required": ["ok", "agent_version", "capabilities"],
          "properties": {
            "ok":            { "type": "boolean" },
            "agent_version": { "type": "string" },
            "capabilities":  { "type": "array", "items": { "type": "string" } },
            "rotated":       { "type": "boolean", "description": "Present and true if token was rotated." }
          }
        }
      },
      "errors": [
        { "code": -32003, "message": "authentication failed" },
        { "code": -32002, "message": "token rotation failed" }
      ]
    },
    {
      "name": "ensure_ssh",
      "summary": "Install/enable OpenSSH Server and inject the host public key.",
      "params": [
        { "name": "public_key",    "required": true,  "schema": { "type": "string" } },
        { "name": "username",      "required": false, "schema": { "type": "string", "default": "Administrator" } },
        { "name": "allow_password","required": false, "schema": { "type": "boolean", "default": false } }
      ],
      "result": {
        "name": "EnsureSshResult",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok":      { "type": "boolean" },
            "details": { "type": "string" }
          }
        }
      }
    },
    {
      "name": "mount_share",
      "summary": "Mount a host filesystem share inside Windows at a guest path.",
      "params": [
        { "name": "backend",    "required": true,  "schema": { "type": "string", "enum": ["smb", "virtio-fs", "9p"] } },
        { "name": "tag_or_unc", "required": true,  "schema": { "type": "string", "description": "UNC path (SMB) or virtio-fs tag." } },
        { "name": "guest_path", "required": true,  "schema": { "type": "string", "description": "Must be under D:\\home\\." } },
        { "name": "mode",       "required": false, "schema": { "type": "string", "enum": ["rw", "ro"], "default": "rw" } },
        { "name": "smb_user",   "required": false, "schema": { "type": "string" } },
        { "name": "smb_pass",   "required": false, "schema": { "type": "string" } }
      ],
      "result": {
        "name": "MountShareResult",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok":      { "type": "boolean" },
            "details": { "type": "string" }
          }
        }
      }
    },
    {
      "name": "run_cmd_shell",
      "summary": "Execute a non-interactive command and return output + exit code.",
      "params": [
        { "name": "cmd",   "required": true,  "schema": { "type": "string" } },
        { "name": "shell", "required": false, "schema": { "type": "string", "default": "powershell.exe" } },
        { "name": "cwd",   "required": false, "schema": { "type": "string" } },
        { "name": "env",   "required": false, "schema": { "type": "object", "additionalProperties": { "type": "string" } } }
      ],
      "result": {
        "name": "RunCmdResult",
        "schema": {
          "type": "object",
          "required": ["exit_code", "stdout", "stderr"],
          "properties": {
            "exit_code": { "type": "integer" },
            "stdout":    { "type": "string" },
            "stderr":    { "type": "string" }
          }
        }
      }
    },
    {
      "name": "open_conpty_shell",
      "summary": "Open a ConPTY-backed interactive shell session.",
      "params": [
        { "name": "shell", "required": false, "schema": { "type": "string", "default": "powershell.exe" } },
        { "name": "cwd",   "required": false, "schema": { "type": "string" } },
        { "name": "env",   "required": false, "schema": { "type": "object" } },
        { "name": "cols",  "required": false, "schema": { "type": "integer", "default": 80 } },
        { "name": "rows",  "required": false, "schema": { "type": "integer", "default": 24 } }
      ],
      "result": {
        "name": "OpenConPtyResult",
        "schema": {
          "type": "object",
          "properties": {
            "session_id": { "type": "string" },
            "ok":         { "type": "boolean" },
            "details":    { "type": "string" }
          }
        }
      }
    },
    {
      "name": "conpty_write",
      "summary": "Write bytes to a ConPTY session (stdin).",
      "params": [
        { "name": "session_id",   "required": true, "schema": { "type": "string" } },
        { "name": "data_base64",  "required": true, "schema": { "type": "string", "contentEncoding": "base64" } }
      ],
      "result": { "name": "OkResult", "schema": { "type": "object", "properties": { "ok": { "type": "boolean" } } } }
    },
    {
      "name": "conpty_read",
      "summary": "Read available bytes from a ConPTY session (stdout/stderr).",
      "params": [
        { "name": "session_id", "required": true, "schema": { "type": "string" } }
      ],
      "result": {
        "name": "ConPtyReadResult",
        "schema": {
          "type": "object",
          "required": ["data_base64", "eof"],
          "properties": {
            "data_base64": { "type": "string", "contentEncoding": "base64" },
            "eof":         { "type": "boolean" }
          }
        }
      }
    },
    {
      "name": "conpty_resize",
      "summary": "Resize a ConPTY session terminal.",
      "params": [
        { "name": "session_id", "required": true,  "schema": { "type": "string" } },
        { "name": "cols",       "required": true,  "schema": { "type": "integer" } },
        { "name": "rows",       "required": true,  "schema": { "type": "integer" } }
      ],
      "result": { "name": "OkResult", "schema": { "type": "object", "properties": { "ok": { "type": "boolean" } } } }
    },
    {
      "name": "conpty_close",
      "summary": "Terminate and clean up a ConPTY session.",
      "params": [
        { "name": "session_id", "required": true, "schema": { "type": "string" } }
      ],
      "result": {
        "name": "ConPtyCloseResult",
        "schema": { "type": "object", "required": ["exit_code"], "properties": { "exit_code": { "type": "integer" } } }
      }
    }
  ]
}
